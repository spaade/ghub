# Copie para .env.local (nunca commite o .env.local de verdade) e preencha
# com a connection string do seu Postgres.
#
# Se estiver usando "Storage -> Postgres" no painel da Vercel, essa
# variável já é injetada automaticamente em produção — esse arquivo é só
# pra rodar `vercel dev` localmente (via `vercel env pull .env.local`).
POSTGRES_URL="postgres://usuario:senha@host:5432/banco?sslmode=require"
