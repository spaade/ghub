# Copie para .env.local (nunca commite o .env.local de verdade) e preencha
# com os dados do seu banco Turso (grátis, sem cartão — https://turso.tech).
#
# Em produção (Vercel), adicione as mesmas duas variáveis em
# Settings -> Environment Variables.
TURSO_DATABASE_URL="libsql://seu-banco-sua-org.turso.io"
TURSO_AUTH_TOKEN="seu-token-gerado-com-turso-db-tokens-create"

# Alternativa pra rodar 100% local, sem precisar criar conta em lugar
# nenhum (comente as duas linhas acima e descomente esta):
# TURSO_DATABASE_URL="file:local.db"

# Alternativa para workers externos: ler a lista pela API ja publicada do app
# em vez de conectar direto no Turso.
MHUB_BASE_URL="https://mhub-ochre.vercel.app"

# Envio diario do resumo da listinha via GOWA.
GOWA_BASE_URL="https://gowa-berk.srv1428821.hstgr.cloud"
GOWA_TO="5511972201959@s.whatsapp.net"
GOWA_AUTH="usuario:senha"
# Opcional, mas recomendado se o GOWA tiver mais de um device conectado.
GOWA_DEVICE_ID=""
SUMMARY_SOURCE="tasks"
SUMMARY_CATEGORIES="consultas,exames"
SUMMARY_TOPIC="Resumo da listinha da Mireia"
DAILY_SUMMARY_TIME="08:00"
DAILY_SUMMARY_TIMEZONE="America/Sao_Paulo"
DAILY_SUMMARY_SEND_EMPTY="true"
DAILY_SUMMARY_CATCH_UP="false"
DAILY_SUMMARY_STATE_FILE="/app/state/daily-summary.json"

# Opcional: protege /api/cron/daily-summary quando usado por cron HTTP.
CRON_SECRET="troque-por-um-token-longo"
