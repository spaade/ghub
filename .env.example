# Copie para .env.local (nunca commite o .env.local de verdade) e preencha
# com os dados do seu banco Turso (grátis, sem cartão — https://turso.tech).
#
# Em produção (Vercel), adicione as mesmas duas variáveis em
# Settings -> Environment Variables.
TURSO_DATABASE_URL="libsql://seu-banco-sua-org.turso.io"
TURSO_AUTH_TOKEN="seu-token-gerado-com-turso-db-tokens-create"

# Alternativa pra rodar 100% local, sem precisar criar conta em lugar
# nenhum (comente as duas linhas acima e descomente esta):
# TURSO_DATABASE_URL="file:local.db"
